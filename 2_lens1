<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>🔬 ESE Multi-Lens Interactive</title>
<script src="https://cdn.plot.ly/plotly-2.27.0.min.js"></script>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: 'Segoe UI', system-ui, sans-serif;
    background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
    min-height: 100vh; padding: 20px; color: #2c3e50;
  }
  .container { max-width: 1600px; margin: 0 auto; }
  .header {
    text-align: center; background: rgba(255,255,255,0.95);
    padding: 22px; border-radius: 18px;
    box-shadow: 0 12px 30px rgba(0,0,0,0.3); margin-bottom: 20px;
  }
  h1 { color: #2c3e50; font-size: 1.8em; margin-bottom: 6px; }
  .subtitle { color: #34495e; font-size: 0.98em; }

  .plots {
    display: grid; grid-template-columns: 1fr 1fr; gap: 20px;
    margin-bottom: 20px;
  }
  @media (max-width: 1200px) { .plots { grid-template-columns: 1fr; } }
  .plot-card {
    background: white; border-radius: 18px;
    box-shadow: 0 12px 30px rgba(0,0,0,0.25);
    padding: 12px; height: 640px;
  }

  .controls {
    background: rgba(255,255,255,0.96); padding: 22px 26px;
    border-radius: 18px; box-shadow: 0 10px 25px rgba(0,0,0,0.2);
    margin-bottom: 20px;
  }
  .controls h2 {
    color: #2c3e50; font-size: 1.15em; margin-bottom: 12px;
    border-bottom: 2px solid #ecf0f1; padding-bottom: 8px;
  }

  /* Чекбоксы */
  .checkbox-row {
    display: flex; flex-wrap: wrap; gap: 20px;
    margin-bottom: 16px; padding: 10px 14px;
    background: #f8f9fb; border-radius: 12px;
    border: 1px solid #ecf0f1;
  }
  .checkbox-row label {
    display: flex; align-items: center; gap: 8px;
    font-weight: 600; color: #2c3e50; font-size: 0.92em;
    cursor: pointer; user-select: none;
  }
  .checkbox-row input[type="checkbox"] {
    width: 17px; height: 17px; cursor: pointer;
    accent-color: #e67e22;
  }
  .checkbox-row .hint {
    color: #7f8c8d; font-weight: 400; font-size: 0.82em;
  }

  /* Слайдеры (общие) */
  .grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px 26px;
  }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } }

  .slider-group label {
    display: flex; justify-content: space-between; align-items: center;
    font-weight: 600; color: #2c3e50; margin-bottom: 5px; font-size: 0.9em;
  }
  .slider-group .val {
    background: #3498db; color: white; padding: 2px 9px;
    border-radius: 12px; font-weight: 700; font-size: 0.82em;
    font-variant-numeric: tabular-nums;
  }
  input[type="range"] {
    width: 100%; height: 6px; border-radius: 4px;
    background: #ecf0f1; outline: none; -webkit-appearance: none;
  }
  input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none; height: 18px; width: 18px;
    border-radius: 50%; background: #3498db; cursor: pointer;
    box-shadow: 0 2px 8px rgba(0,0,0,0.3);
  }
  input[type="range"]::-moz-range-thumb {
    height: 18px; width: 18px; border: none; border-radius: 50%;
    background: #3498db; cursor: pointer;
  }

  /* Панель линз */
  .lenses-panel {
    background: rgba(255,255,255,0.96); padding: 22px 26px;
    border-radius: 18px; box-shadow: 0 10px 25px rgba(0,0,0,0.2);
  }
  .lenses-panel h2 {
    color: #2c3e50; font-size: 1.15em; margin-bottom: 12px;
    border-bottom: 2px solid #ecf0f1; padding-bottom: 8px;
    display: flex; justify-content: space-between; align-items: center;
  }
  .btn-add {
    background: #27ae60; color: white; border: none;
    padding: 6px 14px; border-radius: 8px; cursor: pointer;
    font-weight: 700; font-size: 0.85em;
    box-shadow: 0 3px 10px rgba(39,174,96,0.35);
    transition: transform 0.1s;
  }
  .btn-add:hover { transform: translateY(-1px); }

  .lens-card {
    background: #f8f9fb; border-radius: 12px; padding: 14px 16px;
    margin-bottom: 12px; border-left: 4px solid #3498db;
    position: relative;
  }
  .lens-card h3 {
    font-size: 0.95em; color: #2c3e50; margin-bottom: 10px;
    font-weight: 700;
  }
  .btn-del {
    position: absolute; top: 10px; right: 12px;
    background: #e74c3c; color: white; border: none;
    width: 24px; height: 24px; border-radius: 50%;
    cursor: pointer; font-weight: 700; line-height: 1;
    font-size: 14px;
  }
  .btn-del:hover { background: #c0392b; }
  .btn-del:disabled { background: #bdc3c7; cursor: not-allowed; }

  .lens-grid {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px 20px;
  }
  @media (max-width: 700px) { .lens-grid { grid-template-columns: 1fr; } }

  .status {
    margin-top: 14px; padding: 10px 14px; border-radius: 10px;
    background: #f4f6f8; font-size: 0.88em; color: #34495e;
    font-family: 'Consolas', monospace;
  }
  .status.warn { background: #fff4e5; color: #a35b00; }
</style>
</head>
<body>
<div class="container">
  <div class="header">
    <h1>🔬 ESE Multi-Lens — Interactive</h1>
    <p class="subtitle">
      Monte Carlo ray shooting · N gaussian lenses · α ∝ ν⁻², σ_source ∝ ν⁻¹<br>
      <small>Config A: all lenses at z = 0 · Config B: lenses at different z</small>
    </p>
  </div>

  <div class="plots">
    <div id="rayDiv" class="plot-card"></div>
    <div id="lcDiv" class="plot-card"></div>
  </div>

  <div class="controls">
    <h2>Общие параметры</h2>

    <div class="checkbox-row">
      <label>
        <input type="checkbox" id="showEnsemble" checked>
        Показывать ансамбль лучей (σ_source)
      </label>
      <label>
        <input type="checkbox" id="configB">
        Конфигурация B — линзы на разном z
        <span class="hint">(если снято — все линзы в плоскости z = 0)</span>
      </label>
      <label>
        <input type="checkbox" id="showMultiFreq" checked>
        Многочастотность (ν = 0.5, 1.0, 2.0)
      </label>
    </div>

    <div class="grid">
      <div class="slider-group">
        <label>sigma_source <span class="val" id="sigma-v">1.00</span></label>
        <input type="range" id="sigma" min="0.1" max="3" step="0.05" value="1.0">
      </div>
      <div class="slider-group">
        <label>nu_ref <span class="val" id="nuref-v">1.00</span></label>
        <input type="range" id="nuref" min="0.5" max="4" step="0.1" value="1.0">
      </div>
      <div class="slider-group">
        <label>num_rays <span class="val" id="nrays-v">200</span></label>
        <input type="range" id="nrays" min="10" max="600" step="10" value="200">
      </div>
      <div class="slider-group">
        <label>u_plot_min <span class="val" id="umin-v">-25</span></label>
        <input type="range" id="umin" min="-60" max="-1" step="1" value="-25">
      </div>
      <div class="slider-group">
        <label>u_plot_max <span class="val" id="umax-v">25</span></label>
        <input type="range" id="umax" min="1" max="60" step="1" value="25">
      </div>
      <div class="slider-group">
        <label>noise_level <span class="val" id="noise-v">0.05</span></label>
        <input type="range" id="noise" min="0" max="0.3" step="0.01" value="0.05">
      </div>
    </div>
    <div class="status" id="status">Готово</div>
  </div>

  <div class="lenses-panel">
    <h2>
      Линзы <span style="font-weight:400;color:#7f8c8d;font-size:0.85em" id="nLenses">(2)</span>
      <button class="btn-add" id="addLens">+ Добавить линзу</button>
    </h2>
    <div id="lensesContainer"></div>
  </div>
</div>

<script>
// ============================================================
// КОНСТАНТЫ МОДЕЛИ
// ============================================================
const NU_LIST = [0.5, 1.0, 2.0];
const COLORS  = ['green', 'blue', 'red'];
const V = 0.5;
const T_MAX = 60.0;
const NUM_POINTS = 40;
const RANDOM_SEED = 42;

const NUM_BETA = 4000;
const NUM_U    = 600;
const NUM_BINS = 200;

const RAY_SEED = 777;
const LENS_COLORS = ['#2c7be5', '#27ae60', '#e67e22', '#8e44ad', '#c0392b', '#16a085'];

// ============================================================
// УТИЛИТЫ
// ============================================================
function mulberry32(seed) {
  let a = seed >>> 0;
  return function() {
    a |= 0; a = (a + 0x6D2B79F5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
function gaussian(rng, sigma) {
  let u = 0, v = 0;
  while (u === 0) u = rng();
  while (v === 0) v = rng();
  return sigma * Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
}
function linspace(a, b, n) {
  const arr = new Array(n);
  if (n === 1) { arr[0] = a; return arr; }
  const step = (b - a) / (n - 1);
  for (let i = 0; i < n; i++) arr[i] = a + i * step;
  return arr;
}
function autoURange(lenses, sigmaEff, nuRef, nu, nSigma = 5) {
  const alphaScale = Math.pow(nuRef / nu, 2);
  let alphaMax = 0;
  for (const l of lenses) {
    alphaMax = Math.max(alphaMax, l.alpha);
  }
  alphaMax *= alphaScale;
  const uMax = 0.43 * alphaMax + nSigma * sigmaEff + 5.0;
  return [-uMax, uMax];
}

// ============================================================
// ЯДРО: compute_ese_multi
// ============================================================
function computeEseMulti(lenses, sigmaSource, nu, nuRef,
                         uRange, uPrimeRange,
                         numBeta, numU, numBins, rng) {
  const alphaScale = Math.pow(nuRef / nu, 2);
  const sigmaEff = sigmaSource * Math.pow(nuRef / nu, 1);

  // Копия и сортировка по z
  let lensesSorted = lenses.map(l => ({...l})).sort((a, b) => a.z - b.z);
  if (lensesSorted[0].z !== 0.0) {
    const zShift = lensesSorted[0].z;
    lensesSorted.forEach(l => l.z -= zShift);
  }

  if (!uRange) uRange = autoURange(lensesSorted, sigmaEff, nuRef, nu);
  if (!uPrimeRange) uPrimeRange = uRange;

  const u0 = linspace(uRange[0], uRange[1], numU);

  // u_current и total_deflection: (numBeta, numU)
  // Храним плоские массивы для скорости
  const N = numBeta * numU;
  const uCurrent = new Float64Array(N);
  const totalDefl = new Float64Array(N);

  // Инициализация: u0 повторяется numBeta раз
  for (let k = 0; k < numBeta; k++) {
    for (let i = 0; i < numU; i++) {
      uCurrent[k * numU + i] = u0[i];
    }
  }

  let zPrev = 0.0;
  for (const lens of lensesSorted) {
    const dz = lens.z - zPrev;
    if (dz > 0) {
      for (let idx = 0; idx < N; idx++) {
        uCurrent[idx] += totalDefl[idx] * dz;
      }
    }
    const alphaI = lens.alpha * alphaScale;
    const uOffI = lens.u_offset;
    const aRatioI = lens.a_ratio || 1.0;
    const alphaIEff = alphaI / (aRatioI * aRatioI);
    const gaussI = 1.0 / (aRatioI * aRatioI);

    for (let idx = 0; idx < N; idx++) {
      const uShift = uCurrent[idx] - uOffI;
      const defI = alphaIEff * uShift * Math.exp(-gaussI * uShift * uShift);
      totalDefl[idx] += defI;
    }
    zPrev = lens.z;
  }

  const dzFinal = 1.0 - zPrev;

  // Бины
  const bins = linspace(uPrimeRange[0], uPrimeRange[1], numBins + 1);
  const binW = bins[1] - bins[0];
  const histLensed   = new Float64Array(numBins);
  const histUnlensed = new Float64Array(numBins);

  for (let k = 0; k < numBeta; k++) {
    const betaS = gaussian(rng, sigmaEff);
    for (let i = 0; i < numU; i++) {
      const idx = k * numU + i;
      const upL = uCurrent[idx] + totalDefl[idx] * dzFinal + betaS;
      const upU = u0[i] + betaS;

      let idxL = Math.floor((upL - bins[0]) / binW);
      if (idxL >= 0 && idxL < numBins) histLensed[idxL]++;

      let idxU = Math.floor((upU - bins[0]) / binW);
      if (idxU >= 0 && idxU < numBins) histUnlensed[idxU]++;
    }
  }

  const norm = numBeta * numU * binW;
  const binCenters = new Array(numBins);
  const intensity  = new Array(numBins);
  for (let i = 0; i < numBins; i++) {
    binCenters[i] = (bins[i] + bins[i + 1]) / 2;
    const hU = histUnlensed[i] / norm;
    const hL = histLensed[i]   / norm;
    intensity[i] = hU > 0 ? hL / hU : 0;
  }

  let energy = 0;
  for (let i = 0; i < numBins; i++) energy += intensity[i] * binW;

  return { binCenters, intensity, energy };
}

// ============================================================
// ТРАССИРОВКА ЛУЧЕЙ ДЛЯ ДИАГРАММЫ
// ============================================================
function traceRays(lensesSorted, uLensArray, alphaScale, useEnsemble, sigmaSource, rng) {
  const numRays = uLensArray.length;
  const zSource = -1.0;
  const zObs = 1.0;

  // Начальные позиции
  let uCurrent = new Float64Array(numRays);
  const betaSArr = new Float64Array(numRays);
  for (let k = 0; k < numRays; k++) {
    const betaS = useEnsemble ? gaussian(rng, sigmaSource) : 0.0;
    betaSArr[k] = betaS;
    uCurrent[k] = uLensArray[k] + betaS;
  }

  let totalDefl = new Float64Array(numRays);

  // История: сегменты [z1, z2, u1[], u2[]]
  const segments = [];

  let zPrev = 0.0;
  for (let i = 0; i < lensesSorted.length; i++) {
    const lens = lensesSorted[i];
    const dz = lens.z - zPrev;

    // Пролёт от zPrev до z_i
    const uAtLens = new Float64Array(numRays);
    for (let k = 0; k < numRays; k++) {
      uAtLens[k] = uCurrent[k] + totalDefl[k] * dz;
    }
    segments.push({
      z1: zPrev, z2: lens.z,
      u1: Float64Array.from(uCurrent),
      u2: Float64Array.from(uAtLens)
    });

    // Отклонение
    const alphaI = lens.alpha * alphaScale;
    const uOffI = lens.u_offset;
    const aRatioI = lens.a_ratio || 1.0;
    const alphaIEff = alphaI / (aRatioI * aRatioI);
    const gaussI = 1.0 / (aRatioI * aRatioI);
    for (let k = 0; k < numRays; k++) {
      const uShift = uAtLens[k] - uOffI;
      const defI = alphaIEff * uShift * Math.exp(-gaussI * uShift * uShift);
      totalDefl[k] += defI;
    }

    uCurrent = uAtLens;
    zPrev = lens.z;
  }

  // Финальный полёт до наблюдателя
  const dzFinal = zObs - zPrev;
  const uObs = new Float64Array(numRays);
  for (let k = 0; k < numRays; k++) {
    uObs[k] = uCurrent[k] + totalDefl[k] * dzFinal;
  }
  segments.push({
    z1: zPrev, z2: zObs,
    u1: Float64Array.from(uCurrent),
    u2: Float64Array.from(uObs)
  });

  return { segments, betaSArr };
}

// ============================================================
// ДИАГРАММА ЛУЧЕЙ
// ============================================================
function buildRayTraces(lenses, sigmaSource, nu, nuRef, numRays,
                        uPlotMin, uPlotMax, binCenters, intensity,
                        showEnsemble) {
  const zObs = 1.0;
  const bulgeAmp = 0.05;

  const alphaScale = Math.pow(nuRef / nu, 2);

  // Копия и сортировка
  let lensesSorted = lenses.map(l => ({...l})).sort((a, b) => a.z - b.z);
  if (lensesSorted[0].z !== 0.0) {
    const zShift = lensesSorted[0].z;
    lensesSorted.forEach(l => l.z -= zShift);
  }

  // Сетка для рисования контуров линз
  const nPlot = 400;
  const uPlot = linspace(uPlotMin, uPlotMax, nPlot);

  const traces = [];

  // ---- Слой 1: ансамбль (опционально) ----
  if (showEnsemble) {
    const rng = mulberry32(RAY_SEED);
    const uLensArray = linspace(uPlotMin, uPlotMax, numRays);
    const { segments } = traceRays(lensesSorted, uLensArray, alphaScale,
                                   true, sigmaSource, rng);

    // Сегменты до/после каждой линзы — одним трейсом каждый
    for (const seg of segments) {
      const xArr = [], yArr = [];
      for (let k = 0; k < numRays; k++) {
        xArr.push(seg.u1[k], seg.u2[k], null);
        yArr.push(seg.z1, seg.z2, null);
      }
      traces.push({
        x: xArr, y: yArr, type: 'scatter', mode: 'lines',
        line: { color: 'rgba(255,140,0,0.35)', width: 1 },
        hoverinfo: 'skip', showlegend: false
      });
    }
  }

  // ---- Слой 2: чёткий скелет (beta_s = 0) ----
  {
    const rng = mulberry32(RAY_SEED);  // не используется, но нужен сигнатурой
    const uLensArray = linspace(uPlotMin, uPlotMax, numRays);
    const { segments } = traceRays(lensesSorted, uLensArray, alphaScale,
                                   false, 0.0, rng);

    for (const seg of segments) {
      const xArr = [], yArr = [];
      for (let k = 0; k < numRays; k++) {
        xArr.push(seg.u1[k], seg.u2[k], null);
        yArr.push(seg.z1, seg.z2, null);
      }
      traces.push({
        x: xArr, y: yArr, type: 'scatter', mode: 'lines',
        line: { color: 'black', width: 0.7 },
        opacity: 0.7, hoverinfo: 'skip', showlegend: false
      });
    }
  }

  // ---- Линзы ----
  for (let i = 0; i < lensesSorted.length; i++) {
    const lens = lensesSorted[i];
    const aRatioI = lens.a_ratio || 1.0;
    const gaussI = 1.0 / (aRatioI * aRatioI);
    const bulge = new Float64Array(nPlot);
    for (let k = 0; k < nPlot; k++) {
      const du = uPlot[k] - lens.u_offset;
      bulge[k] = bulgeAmp * Math.exp(-gaussI * du * du);
    }
    const color = LENS_COLORS[i % LENS_COLORS.length];
    const yTop = uPlot.map((_, k) => lens.z - bulge[k]);
    const yBot = uPlot.map((_, k) => lens.z + bulge[k]);

    traces.push({
      x: uPlot.concat([...uPlot].reverse()),
      y: yTop.concat([...yBot].reverse()),
      type: 'scatter', mode: 'lines',
      fill: 'toself', fillcolor: color + '66',
      line: { color: color, width: 1 },
      name: `Lens ${i + 1} (z=${lens.z.toFixed(2)}, α=${lens.alpha})`,
      hoverinfo: 'skip'
    });
  }

  // ---- Плоскость наблюдателя ----
  traces.push({
    x: [uPlotMin, uPlotMax], y: [zObs, zObs],
    type: 'scatter', mode: 'lines',
    line: { color: 'red', dash: 'dot', width: 3 },
    name: 'Observer'
  });

  // ---- Кривая блеска (отражённая) ----
  if (binCenters && intensity) {
    const xLC = [], yLC = [];
    for (let i = 0; i < binCenters.length; i++) {
      if (binCenters[i] < uPlotMin || binCenters[i] > uPlotMax) continue;
      xLC.push(binCenters[i]);
      yLC.push(-0.1 * (intensity[i] - 1) + zObs);
    }
    traces.push({
      x: xLC, y: yLC, type: 'scatter', mode: 'lines',
      line: { color: '#1f77b4', width: 3 },
      name: 'Light curve (ν_ref)', hoverinfo: 'skip'
    });
  }

  return traces;
}

// ============================================================
// КРИВАЯ БЛЕСКА
// ============================================================
function buildLightCurveTraces(results, nuLabels, xlimU, uPrime0,
                                noiseLevel, showMultiFreq) {
  const traces = [];
  const nuArr = showMultiFreq ? NU_LIST : [1.0];
  const colorsArr = showMultiFreq ? COLORS : ['blue'];

  // Сортировка по частоте
  const idxs = [...nuArr.keys()].sort((a, b) => nuArr[a] - nuArr[b]);

  for (const i of idxs) {
    const nu = nuArr[i];
    const res = results[i];
    if (!res) continue;
    const color = colorsArr[i] || 'blue';

    let label;
    if (Math.abs(nu - 1.0) < 1e-9) label = 'ν = ν_ref';
    else label = `ν = ${nu.toFixed(2)} ν_ref`;

    traces.push({
      x: res.binCenters, y: res.intensity,
      type: 'scatter', mode: 'lines',
      line: { color, width: 2 },
      name: label, opacity: 0.9
    });
  }

  traces.push({
    x: [xlimU[0], xlimU[1]], y: [1, 1],
    type: 'scatter', mode: 'lines',
    line: { color: 'gray', dash: 'dash', width: 1 },
    name: 'Unlensed'
  });

  // Шумовые точки — только для опорной частоты (nu = 1)
  const idxRef = nuArr.indexOf(1.0);
  if (idxRef >= 0 && results[idxRef]) {
    const bcRef = results[idxRef].binCenters;
    const IRef  = results[idxRef].intensity;
    const rng = mulberry32(RANDOM_SEED);
    const tPoints = linspace(0, T_MAX, NUM_POINTS);
    const upPoints = tPoints.map(t => uPrime0 + V * t);

    const xObs = [], yObs = [], yErr = [];
    for (let k = 0; k < NUM_POINTS; k++) {
      const up = upPoints[k];
      if (up < xlimU[0] || up > xlimU[1]) continue;
      let iModel = 0;
      for (let j = 0; j < bcRef.length - 1; j++) {
        if (up >= bcRef[j] && up <= bcRef[j + 1]) {
          const frac = (up - bcRef[j]) / (bcRef[j + 1] - bcRef[j]);
          iModel = IRef[j] * (1 - frac) + IRef[j + 1] * frac;
          break;
        }
      }
      const noise = gaussian(rng, noiseLevel);
      xObs.push(up);
      yObs.push(iModel + noise);
      yErr.push(noiseLevel);
    }

    traces.push({
      x: xObs, y: yObs,
      error_y: { type: 'data', array: yErr, visible: true, thickness: 0.8 },
      type: 'scatter', mode: 'markers',
      marker: { color: 'black', size: 5 },
      name: 'Simulated data'
    });
  }

  return traces;
}

